<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.seuapp.desktop.controller.MainController"
      styleClass="window-root">

    <!-- =====================================================
         TITLE BAR
         ===================================================== -->

    <HBox fx:id="titleBar"
          styleClass="title-bar"
          alignment="CENTER_LEFT"
          prefHeight="42"
          minHeight="42"
          maxHeight="42">

        <padding>
            <Insets top="0"
                    right="0"
                    bottom="0"
                    left="14"/>
        </padding>

        <!-- ÍCONE -->

        <ImageView fx:id="appIconView"
                   fitWidth="20"
                   fitHeight="20"
                   preserveRatio="true"/>

        <!-- NOME -->

        <Label text="Y96TUBE"
               styleClass="window-title"/>

        <!-- ESPAÇO -->

        <Region HBox.hgrow="ALWAYS"/>

        <!-- ACESSIBILIDADE -->

        <Button fx:id="accessibilityButton"
                accessibleText="Alternar modo escuro"
                styleClass="window-control, accessibility-button"
                prefWidth="42"
                prefHeight="42"/>

        <!-- MINIMIZAR -->

        <Button fx:id="minimizeButton"
                accessibleText="Minimizar"
                styleClass="window-control"
                prefWidth="46"
                prefHeight="42"/>

        <!-- MAXIMIZAR -->

        <Button fx:id="maximizeButton"
                accessibleText="Maximizar"
                styleClass="window-control"
                prefWidth="46"
                prefHeight="42"/>

        <!-- FECHAR -->

        <Button fx:id="closeButton"
                accessibleText="Fechar"
                styleClass="window-control, close-button"
                prefWidth="46"
                prefHeight="42"/>

    </HBox>


    <!-- =====================================================
         CONTEÚDO DO APLICATIVO
         ===================================================== -->

    <VBox spacing="16"
          styleClass="content-area">

        <padding>
            <Insets top="22"
                    right="24"
                    bottom="24"
                    left="24"/>
        </padding>


        <!-- =================================================
             TÍTULO
             ================================================= -->

        <Label text="YouTube Converter"
               styleClass="title-label"/>


        <!-- =================================================
             URL
             ================================================= -->

        <HBox spacing="8">

            <TextField fx:id="urlField"
                       promptText="Cole o link do YouTube aqui"
                       HBox.hgrow="ALWAYS"/>

            <Button fx:id="listFormatsButton"
                    text="Buscar formatos"
                    onAction="#onListFormats"/>

        </HBox>


        <!-- =================================================
             PREVIEW DO VÍDEO
             ================================================= -->

        <VBox fx:id="videoPreviewBox"
              styleClass="video-preview"
              spacing="10"
              managed="false"
              visible="false">

            <HBox spacing="14"
                  alignment="CENTER_LEFT">

                <!-- THUMBNAIL -->

                <StackPane styleClass="thumbnail-container">

                    <ImageView fx:id="thumbnailImage"
                               fitWidth="150"
                               fitHeight="85"
                               preserveRatio="true"/>

                </StackPane>


                <!-- INFORMAÇÕES DO VÍDEO -->

                <VBox spacing="5"
                      HBox.hgrow="ALWAYS">

                    <Label fx:id="videoTitleLabel"
                           styleClass="video-title"
                           wrapText="true"/>

                    <Label fx:id="videoChannelLabel"
                           styleClass="video-channel"/>

                </VBox>

            </HBox>

        </VBox>


        <!-- =================================================
             TIPO DE SAÍDA
             ================================================= -->

        <HBox spacing="18"
              styleClass="output-selector">

            <fx:define>

                <ToggleGroup fx:id="outputTypeGroup"/>

            </fx:define>


            <RadioButton fx:id="mp3Radio"
                         text="MP3 (áudio)"
                         toggleGroup="$outputTypeGroup"/>


            <RadioButton fx:id="mp4Radio"
                         text="MP4 (vídeo)"
                         toggleGroup="$outputTypeGroup"/>

        </HBox>


        <!-- =================================================
             FORMATO
             ================================================= -->

        <Label text="Qualidade / formato"
               styleClass="field-label"/>


        <ComboBox fx:id="formatComboBox"
                  maxWidth="Infinity"/>


        <!-- =================================================
             AÇÕES
             ================================================= -->

        <HBox spacing="8"
              styleClass="action-buttons">

            <Button fx:id="downloadButton"
                    text="Baixar"
                    onAction="#onDownload"/>


            <Button fx:id="cancelButton"
                    text="Cancelar"
                    onAction="#onCancelarDownload"
                    disable="true"/>

        </HBox>


        <!-- =================================================
             PROGRESSO
             ================================================= -->

        <ProgressBar fx:id="progressBar"
                     progress="0"
                     maxWidth="Infinity"/>


        <!-- =================================================
             STATUS
             ================================================= -->

        <Label fx:id="statusLabel"
               text="Pronto."
               wrapText="true"/>

    </VBox>

</VBox>